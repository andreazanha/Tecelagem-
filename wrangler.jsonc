{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rolagem-de-fase",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rolagem-de-fase",
      // Substitua pelo id real após `wrangler d1 create rolagem-de-fase`.
      // Para desenvolvimento local (--local) qualquer valor funciona.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rolagem-de-fase-arquivos"
    }
  ],
  "observability": { "enabled": true }
}
