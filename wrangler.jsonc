{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rolagem-de-fase",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rolagem-de-fase",
      "database_id": "ef152da6-0798-42aa-a5ee-593539ddf17c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rolagem-de-fase-arquivos"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Web Push (aviso "entrou pedido novo"). Só a chave PÚBLICA fica no repo.
  // A chave privada (VAPID_JWK) é um secret — definir uma vez no deploy:
  //   wrangler secret put VAPID_JWK
  "vars": {
    "VAPID_PUBLIC": "BI98zOHBfNIegLgU1F2RireVjvhlsgeZB3JO1uaZEWj4qUnwcVu-S75I2sUxe5nqbn7HVfkc8QQnp5e8j1bcJ0U",
    "VAPID_SUBJECT": "mailto:admin@bigtricot.com.br"
  }
}
