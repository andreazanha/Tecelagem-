{
  "name": "rolagem-de-fase",
  "private": true,
  "type": "module",
  "description": "Big Tricot — Rolagem de Fase (Cloudflare Workers + Hono + D1 + R2)",
  "scripts": {
    "install:all": "npm install && npm --prefix web install",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/seed.sql",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.103.0"
  }
}
