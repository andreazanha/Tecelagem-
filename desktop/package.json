{
  "name": "bigtricot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Camada desktop (Electron) do Big Tricot — abre o app web e o Navegador CRM com navegador real embutido.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.bigtricot.desktop",
    "productName": "Big Tricot",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Big Tricot"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
